# JARVIS configuration -- copy to .env and edit.

# Owner account seeding (see core/identity/user_store.py).
# The owner account is created ONCE on first run if this is set.
# There is deliberately no default password anywhere in the source.
OWNER_PASSWORD=

# SANDBOX PACKAGE POLICY (see core/skills/sandbox_policy.py).
# Installs are OFF unless explicitly enabled, and even then only
# packages named here are installed. Anything else is reported, never
# installed -- because `pip install <model-supplied-name>` runs that
# package's own setup.py at install time, so a hallucinated or
# typo-squatted name executes code before any import happens. The
# allowlist removes that property while keeping the convenience.
JARVIS_ALLOW_INSTALL=false
JARVIS_ALLOWED_PACKAGES=numpy,pandas,requests,matplotlib,pillow

# Auth storage
JARVIS_AUTH_DB=data/auth.db
JARVIS_SESSION_SECRET_FILE=data/session_secret.key
